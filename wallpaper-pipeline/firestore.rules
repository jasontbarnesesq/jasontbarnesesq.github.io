rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Job documents are created and updated exclusively by the backend
    // (Cloud Functions Admin SDK, which bypasses these rules). Clients may
    // only read their own jobs, and may never write directly.
    match /jobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }
  }
}
